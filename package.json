{
  "name": "yazzy-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/api-client",
    "packages/image-size-compat"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "apk": "python scripts/build_apk.py",
    "typecheck": "npm run typecheck --workspace apps/web && npm run typecheck --workspace apps/mobile",
    "test:e2e": "playwright test",
    "contracts": "openapi-typescript contracts/openapi.json -o packages/api-client/src/schema.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "postcss": "8.5.31",
    "node-forge": "1.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "decode-uri-component": "0.5.1",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "image-size": "file:packages/image-size-compat"
  }
}

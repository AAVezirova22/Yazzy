{
 "expo": {
  "name": "Yazzy",
  "slug": "yazzy",
  "scheme": "yazzy",
  "version": "0.1.0",
  "orientation": "portrait",
  "userInterfaceStyle": "light",
  "newArchEnabled": true,
  "ios": {
   "bundleIdentifier": "com.yazzy.vehicle",
   "supportsTablet": false,
   "infoPlist": {
    "NSBluetoothAlwaysUsageDescription": "Connect to your selected OBD adapter to record supported vehicle readings.",
    "NSLocationWhenInUseUsageDescription": "Record route and distance while you explicitly record a trip.",
    "NSLocationAlwaysAndWhenInUseUsageDescription": "Continue an explicitly started journey when the screen is locked.",
    "UIBackgroundModes": [
     "bluetooth-central",
     "location"
    ]
   }
  },
  "android": {
   "package": "com.yazzy.vehicle",
   "permissions": [
    "BLUETOOTH_SCAN",
    "BLUETOOTH_CONNECT",
    "ACCESS_FINE_LOCATION",
    "ACCESS_COARSE_LOCATION",
    "FOREGROUND_SERVICE",
    "FOREGROUND_SERVICE_CONNECTED_DEVICE",
    "FOREGROUND_SERVICE_LOCATION",
    "POST_NOTIFICATIONS",
    "REQUEST_INSTALL_PACKAGES"
   ]
  },
  "plugins": [
   "expo-router",
   "expo-secure-store",
   [
    "expo-local-authentication",
    {
     "faceIDPermission": "Yazzy uses Face ID to unlock your account."
    }
   ],
   [
    "expo-font",
    {
     "fonts": [
      "./assets/fonts/Manrope-Medium.ttf",
      "./assets/fonts/Manrope-SemiBold.ttf",
      "./assets/fonts/Manrope-Bold.ttf",
      "./assets/fonts/Manrope-ExtraBold.ttf"
     ]
    }
   ],
   "./plugins/withRecorder"
  ],
  "experiments": {
   "typedRoutes": true
  }
 }
}

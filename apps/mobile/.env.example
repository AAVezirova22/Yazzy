# Copy to .env.local (gitignored) and fill in before running `npm run apk`.
# Google Maps key restricted to Android app com.yazzy.vehicle + Maps SDK for Android.
GOOGLE_MAPS_API_KEY=
# Hosted API the app talks to by default (editable in the app).
EXPO_PUBLIC_API_URL=https://yazzy-api.onrender.com
# Optional: GitHub token for `--publish` (uploads to the repo's `android` release). Without it the
# build uses the GitHub sign-in git already has for pushing.
GITHUB_TOKEN=
